{
  "openapi": "3.1.0",
  "info": {
    "title": "TWZRD Live 0\u21921Q",
    "version": "1.0.0",
    "description": "Machine-readable operator board for getting intel.twzrd.xyz from live infra to live demand. Prefer JSON over HTML. CORS open, no auth."
  },
  "servers": [
    {
      "url": "https://twzrd-live-board.vercel.app",
      "description": "Public Vercel production"
    },
    {
      "url": "https://raw.githubusercontent.com/grid-kernel/twzrd-live-01q/main/public-machine",
      "description": "GitHub raw snapshot mirror"
    }
  ],
  "paths": {
    "/llms.txt": {
      "get": {
        "summary": "Agent markdown guide",
        "operationId": "getLlmsTxt"
      }
    },
    "/api/board": {
      "get": {
        "summary": "Full board snapshot",
        "operationId": "getBoard"
      }
    },
    "/api/board/status": {
      "get": {
        "summary": "Live status + next actions",
        "operationId": "getStatus"
      }
    },
    "/api/board/moves": {
      "get": {
        "summary": "Playbook moves",
        "operationId": "getMoves"
      }
    },
    "/api/intel-health": {
      "get": {
        "summary": "Proxy intel health",
        "operationId": "getHealth"
      }
    },
    "/api/openapi.json": {
      "get": {
        "summary": "This document",
        "operationId": "getOpenApi"
      }
    },
    "/board.json": {
      "get": {
        "summary": "Full board snapshot (alias)"
      }
    },
    "/status.json": {
      "get": {
        "summary": "Status (alias)"
      }
    },
    "/moves.json": {
      "get": {
        "summary": "Moves (alias)"
      }
    }
  }
}